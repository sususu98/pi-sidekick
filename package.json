{
	"name": "pi-sidekick",
	"version": "0.1.0",
	"description": "Fusion for Pi: a frontier lead model plans and reviews while one or more cost-efficient sidekick models do the hands-on work",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension",
		"fusion",
		"sidekick",
		"multi-agent"
	],
	"license": "MIT",
	"author": "sususu98",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sususu98/pi-sidekick.git"
	},
	"bugs": {
		"url": "https://github.com/sususu98/pi-sidekick/issues"
	},
	"homepage": "https://github.com/sususu98/pi-sidekick#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"bun": ">=1.2.0"
	},
	"packageManager": "bun@1.4.2",
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"check": "bun run typecheck && bun test"
	},
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.1.0",
		"@earendil-works/pi-ai": ">=1.1.0",
		"typebox": "^1.3.27"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.1.0",
		"@earendil-works/pi-coding-agent": "1.1.0",
		"@types/bun": "^1.2.0",
		"@types/proper-lockfile": "^4.1.4",
		"typebox": "1.3.27",
		"typescript": "^5.9.0"
	},
	"files": [
		"extensions",
		"docs",
		"README.md",
		"LICENSE"
	],
	"dependencies": {
		"proper-lockfile": "^4.1.2"
	}
}
